{
  "name": "tradedesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full-PPR fantasy football projections and a trade evaluator that does the roster math",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "bundle": "node scripts/bundle.mjs",
    "build": "python3 pipeline/build_pack.py && node scripts/bundle.mjs",
    "bootstrap": "python3 pipeline/bootstrap.py",
    "refresh": "python3 pipeline/refresh.py",
    "verify": "npm test && python3 pipeline/sanity.py",
    "verify:browser": "node scripts/bundle.mjs && node scripts/verify-browser.mjs"
  },
  "devDependencies": {
    "playwright": "1.49.1"
  },
  "engines": { "node": ">=20" }
}
